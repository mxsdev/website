---
import Base from "../../layouts/Base.astro";
import LottieMark from "../../components/LottieMark.astro";
import { Content } from "../../content/towards-craftsmanship.md";
---

<Base title="Towards Craftsmanship in AI Engineering — mxs.dev">
  <a class="home-mark" href="/" aria-label="mxs.dev home">
    <LottieMark src="/lottie/mxsdev.json" class="mark-nav" play={false} />
  </a>
  <main class="post">
    <div class="column">
      <p class="back">
        <a href="/">← mxs.dev</a>
      </p>
      <h1>Towards Craftsmanship in AI Engineering</h1>
      <p class="byline">Max Stoumen · October 19, 2026</p>
      <div class="body">
        <Content />
      </div>
    </div>
  </main>
</Base>

<style>
  .home-mark {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    display: block;
    width: fit-content;
    text-decoration: none;
    color: inherit;
  }

  .home-mark :global(.mark-nav) {
    width: 5.5rem;
    margin-inline: 0;
  }

  .post {
    background-color: #fff;
    color: #000;
    padding: 2rem 1.25rem 6rem;
    box-sizing: border-box;
  }

  .column {
    max-width: 32rem;
    margin: 0 auto;
  }

  .back {
    margin: 0;
    font-family: "Ogg", Georgia, serif;
    font-size: 1rem;
  }

  .back a {
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .back a:hover,
  .back a:focus {
    text-decoration: underline;
  }

  h1 {
    text-align: left;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: bold;
    font-family: "Ogg", Georgia, serif;
    margin: 2rem 0 0;
    line-height: 1.3;
  }

  .byline {
    margin: 1rem 0 0;
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: #444;
  }

  .body {
    margin-top: 2.5rem;
  }

  .body :global(a),
  .body :global(a:visited),
  .body :global(a:active) {
    color: #000;
  }

  .body :global(a:hover),
  .body :global(a:focus) {
    color: #444;
    text-decoration: underline;
  }

  .body :global(a) {
    font-weight: 400;
  }

  .body :global(em) {
    font-style: italic;
  }

  .body :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 1px solid #ccc;
    font-style: italic;
  }

  .body :global(h2),
  .body :global(h3),
  .body :global(h4),
  .body :global(h5),
  .body :global(h6) {
    font-family: "Ogg", Georgia, serif;
  }

  .body :global(h2) {
    font-size: 1.5rem;
    font-weight: 500;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .body :global(p) {
    line-height: 1.65;
    margin: 0 0 2rem;
  }
</style>
