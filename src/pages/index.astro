---
import Base from "../layouts/Base.astro";
import AboutPanel from "../components/AboutPanel.astro";
import LottieMark from "../components/LottieMark.astro";

const posts = [
  {
    title: "Towards Craftsmanship in AI Engineering",
    href: "/blog/towards-craftsmanship-in-ai-engineering",
    date: "October 19, 2026",
    datetime: "2026-10-19",
  },
];
---

<Base title="mxs.dev">
  <main class="home">
    <LottieMark src="/lottie/mxsdev.json" class="mark" />

    <AboutPanel>
      <span>23</span>
      <span>no degree</span>
      <span>senior eng @ <a href="https://miter.com">Miter</a></span>
    </AboutPanel>

    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={post.href}>{post.title}</a>
            <time datetime={post.datetime}>{post.date}</time>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .home {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
    box-sizing: border-box;
  }

  .mark {
    width: min(100%, 28rem);
  }

  .post-list {
    list-style: none;
    margin: 4rem auto 0;
    padding: 0;
    max-width: 32rem;
    width: 100%;
  }

  .post-list li {
    margin-bottom: 1.25rem;
  }

  .post-list li:last-child {
    margin-bottom: 0;
  }

  .post-list a {
    font-family: "Ogg", Georgia, serif;
    font-weight: 400;
    font-size: 1.25rem;
    color: #000;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .post-list a:hover,
  .post-list a:focus {
    text-decoration: underline;
    font-weight: 500;
  }

  .post-list time {
    display: block;
    margin-top: 0.35rem;
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: 0.85rem;
    color: #666;
    letter-spacing: 0.02em;
  }
</style>
