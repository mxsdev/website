---
interface Props {
  title?: string;
  description?: string;
  /** Path only, e.g. `/blog/...` — resolved against site origin. */
  canonicalPath?: string;
  /** Absolute or site-root path for social preview image. */
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  /** Soft-unlist from search indexes if needed later. Prefer sitemap omission instead. */
  noindex?: boolean;
}

const site = Astro.site ?? new URL("https://www.mxs.dev");
const {
  title = "mxs",
  description = "Max Stoumen — software artisan of the physical world.",
  canonicalPath = Astro.url.pathname,
  image = "/apple-touch-icon.png",
  ogType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site).href;
const imageUrl = new URL(image, site).href;
const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Max Stoumen" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>

    <!-- Critical body faces: fetch early so swap happens ASAP. -->
    <link
      rel="preload"
      href="/font/OggText-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/font/OggText-LightItalic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="mxs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:author" content="Max Stoumen" />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <style is:global>
      @font-face {
        font-family: "Ogg Text";
        src: url("/font/OggText-Light.woff2") format("woff2");
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Ogg Text";
        src: url("/font/OggText-LightItalic.woff2") format("woff2");
        font-weight: 300;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: "Ogg";
        src: url("/font/Ogg-Light.woff2") format("woff2");
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Ogg";
        src: url("/font/Ogg-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Ogg";
        src: url("/font/Ogg-Medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Ogg";
        src: url("/font/Ogg-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      html {
        font-family: "Ogg Text", Georgia, "Times New Roman", serif;
        font-weight: 300;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background-color: #fff;
        color: #000;
      }

      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
