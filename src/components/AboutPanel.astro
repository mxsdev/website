---
---

<div class="about-wrap">
  <p class="tagline">
    <slot />
    <button
      type="button"
      class="about-toggle"
      aria-expanded="false"
      aria-controls="about-panel"
      data-about-toggle
    >
      about
      <span class="chevron" aria-hidden="true">›</span>
    </button>
  </p>

  <div
    id="about-panel"
    class="about-panel"
    data-about-panel
    hidden
    role="region"
    aria-label="About"
  >
    <p>
      software artisan of the physical world. interested in classical
      counterpoint,
      <a href="https://en.wikipedia.org/wiki/Lebensphilosophie"
        >lebensphilosophie</a
      >, mathematics of sheaves and germs
    </p>
  </div>
</div>

<script>
  const FPS = 12;
  const FRAME_MS = 1000 / FPS;
  const FRAMES = 5;

  function posterize(apply: (t: number) => void, onDone?: () => void) {
    let i = 0;
    apply(0);
    const id = setInterval(() => {
      i += 1;
      apply(i / FRAMES);
      if (i >= FRAMES) {
        clearInterval(id);
        onDone?.();
      }
    }, FRAME_MS);
    return id;
  }

  function mount() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-about-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-about-panel]");
    if (!toggle || !panel || toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";

    let open = false;
    let running: ReturnType<typeof setInterval> | null = null;
    const chevron = toggle.querySelector<HTMLElement>(".chevron");

    const setVisual = (t: number, opening: boolean) => {
      const p = opening ? t : 1 - t;
      panel.style.opacity = String(p);
      panel.style.transform = `translateY(${(1 - p) * -0.45}rem)`;
      if (chevron) chevron.style.transform = `rotate(${p * 90}deg)`;
    };

    toggle.addEventListener("click", () => {
      if (running) clearInterval(running);

      if (!open) {
        open = true;
        toggle.setAttribute("aria-expanded", "true");
        panel.hidden = false;
        running = posterize((t) => setVisual(t, true), () => {
          running = null;
        });
      } else {
        open = false;
        toggle.setAttribute("aria-expanded", "false");
        running = posterize((t) => setVisual(t, false), () => {
          panel.hidden = true;
          running = null;
        });
      }
    });
  }

  mount();
  document.addEventListener("astro:page-load", mount);
</script>

<style>
  .about-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .tagline {
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: clamp(0.8rem, 1.8vw, 0.95rem);
    letter-spacing: 0.02em;
    text-align: center;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 2.5rem;
    row-gap: 0.5rem;
  }

  .tagline :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .tagline :global(a:hover),
  .tagline :global(a:focus) {
    text-decoration: underline;
  }

  .about-toggle {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .about-toggle:hover,
  .about-toggle:focus-visible {
    text-decoration: underline;
    outline: none;
  }

  .chevron {
    display: inline-block;
    line-height: 1;
    transform-origin: center;
  }

  .about-panel {
    width: min(100%, 28rem);
    margin: 1.25rem auto 0;
    opacity: 0;
    transform: translateY(-0.45rem);
  }

  .about-panel[hidden] {
    display: none;
  }

  .about-panel:not([hidden]) {
    display: block;
  }

  .about-panel p {
    margin: 0;
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: clamp(0.85rem, 1.9vw, 1rem);
    line-height: 1.55;
    letter-spacing: 0.02em;
    text-align: center;
    color: #333;
  }

  .about-panel a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .about-panel a:hover,
  .about-panel a:focus {
    color: #000;
  }
</style>
