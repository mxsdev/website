---

---

<div class="about-wrap">
  <p class="tagline">
    <slot />
    <button
      type="button"
      class="about-toggle"
      aria-expanded="false"
      aria-controls="about-panel"
      data-about-toggle
    >
      about
      <span class="chevron" aria-hidden="true">›</span>
    </button>
  </p>

  <div
    id="about-panel"
    class="about-panel"
    data-about-panel
    role="region"
    aria-label="About"
    aria-hidden="true"
  >
    <div class="about-panel-inner" data-about-inner>
      <p>
        building software for the physical world. interested in classical
        counterpoint,{" "}
        <a href="https://en.wikipedia.org/wiki/Lebensphilosophie"
          >lebensphilosophie</a
        >, mathematics of sheaves and germs.{" "}
        <a href="https://www.linkedin.com/in/mxsdev/">LI</a>,{" "}
        <a href="mailto:max@mxs.dev">contact</a>
      </p>
    </div>
  </div>
</div>

<script>
  const FPS = 12;
  const FRAME_MS = 1000 / FPS;
  const FRAMES = 12;
  const SLIDE_REM = 1.35;

  /** Hard ease-out so each 12fps step lands with a visible jump. */
  function easeOutQuint(t: number) {
    return 1 - Math.pow(1 - t, 5);
  }

  function posterize(apply: (t: number) => void, onDone?: () => void) {
    let i = 0;
    apply(easeOutQuint(0));
    const id = setInterval(() => {
      i += 1;
      apply(easeOutQuint(i / FRAMES));
      if (i >= FRAMES) {
        clearInterval(id);
        onDone?.();
      }
    }, FRAME_MS);
    return id;
  }

  function measureOpenHeight(panel: HTMLElement, inner: HTMLElement) {
    const prev = panel.style.height;
    panel.style.height = "auto";
    const h = inner.getBoundingClientRect().height;
    panel.style.height = prev;
    return h;
  }

  function mount() {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-about-toggle]",
    );
    const panel = document.querySelector<HTMLElement>("[data-about-panel]");
    const inner = document.querySelector<HTMLElement>("[data-about-inner]");
    if (!toggle || !panel || !inner || toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";

    let open = false;
    let running: ReturnType<typeof setInterval> | null = null;
    const chevron = toggle.querySelector<HTMLElement>(".chevron");

    const setVisual = (p: number, targetHeight: number) => {
      panel.style.height = `${targetHeight * p}px`;
      inner.style.opacity = String(p);
      inner.style.transform = `translateY(${(1 - p) * -SLIDE_REM}rem)`;
      if (chevron) chevron.style.transform = `rotate(${p * 90}deg)`;
    };

    toggle.addEventListener("click", () => {
      if (running) clearInterval(running);

      if (!open) {
        open = true;
        toggle.setAttribute("aria-expanded", "true");
        panel.setAttribute("aria-hidden", "false");
        const targetHeight = measureOpenHeight(panel, inner);

        running = posterize(
          (p) => setVisual(p, targetHeight),
          () => {
            panel.style.height = "auto";
            running = null;
          },
        );
      } else {
        open = false;
        toggle.setAttribute("aria-expanded", "false");
        panel.setAttribute("aria-hidden", "true");
        const targetHeight = measureOpenHeight(panel, inner);
        panel.style.height = `${targetHeight}px`;

        // Ease-in on close = reverse of ease-out open (big early collapse).
        running = posterize(
          (p) => setVisual(1 - p, targetHeight),
          () => {
            panel.style.height = "0px";
            running = null;
          },
        );
      }
    });
  }

  mount();
  document.addEventListener("astro:page-load", mount);
</script>

<style>
  .about-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .tagline {
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: clamp(0.8rem, 1.8vw, 0.95rem);
    letter-spacing: 0.02em;
    text-align: center;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 2.5rem;
    row-gap: 0.5rem;
  }

  .tagline :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .tagline :global(a:hover),
  .tagline :global(a:focus) {
    text-decoration: underline;
  }

  .about-toggle {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .about-toggle:hover,
  .about-toggle:focus-visible {
    text-decoration: underline;
    outline: none;
  }

  .chevron {
    display: inline-block;
    line-height: 1;
    transform-origin: center;
  }

  .about-panel {
    width: min(100%, 28rem);
    height: 0;
    overflow: hidden;
  }

  .about-panel-inner {
    padding-top: 1.25rem;
    opacity: 0;
    transform: translateY(-1.35rem);
  }

  .about-panel-inner p {
    margin: 0;
    font-family: "Ogg Text", Georgia, serif;
    font-weight: 300;
    font-size: clamp(0.85rem, 1.9vw, 1rem);
    line-height: 1.55;
    letter-spacing: 0.02em;
    text-align: center;
    color: #333;
  }

  .about-panel-inner a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .about-panel-inner a:hover,
  .about-panel-inner a:focus {
    color: #000;
  }
</style>
